OPENAI_API_KEY=
CUNAI_API_KEY=
SUDOCODE_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
QIANFAN_API_KEY=

# 自定义 OpenAI-compatible / 常见图片响应接口。
CUSTOM_TEXT_API_KEY=
CUSTOM_IMAGE_API_KEY=

# Base URL、Endpoint、协议适配器、模型和附加请求头在 resources/ai_providers.json 中维护；修改后重启程序。
